# Server
PORT=8080
NODE_ENV=development

# PostgreSQL 15 + pgvector
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/un_whatsapp_manager

# Used only to encrypt/decrypt the API key saved for each BOT.
# Use a stable random secret of at least 32 characters and keep it private.
APP_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Twilio fallback. The same values can be managed by an administrator in Settings.
# The Auth Token is always required to verify incoming webhook signatures.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_BASE_URL=

# First administrator, created only when the users table is empty.
# Use at least 10 characters for the password, then rotate it from Settings.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD

# Login session duration.
SESSION_HOURS=12

# Optional server-to-server endpoint token.
OUTBOUND_API_KEY=

# Fallback SMTP. Gli stessi valori sono configurabili dal CRM e cifrati nel database.
SMTP_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=

# Lease dei job email interrotti.
EMAIL_CLAIM_TIMEOUT_MINUTES=30

# Storage allegati. Usa "s3" con un provider S3 compatibile oppure "database" in locale.
MEDIA_STORAGE_PROVIDER=database
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PREFIX=un-platform

# Development-only authentication bypass.
DEV_ADMIN_EMAIL=

# Comma-separated browser origins. Empty accepts the current origin.
ALLOWED_ORIGINS=

# Pause between broadcast recipients; tune for the sender throughput.
BROADCAST_DELAY_MS=100

# Mark interrupted claims as failed after this interval; they are never resent automatically.
BROADCAST_CLAIM_TIMEOUT_MINUTES=60
